class Solution {
    public long maxAlternatingSum(int[] nums) {
        PriorityQueue<Integer> PQ = new PriorityQueue<>();
        for(int num : nums) {
            int temp = Math.abs(num);
            PQ.add(temp);
        }
        int n = nums.length;
        int negative = n / 2;
        long y = 0;
        while(negative-- > 0) {
            y -= (PQ.peek() * PQ.poll());
        }
        long x = 0;
        while(!PQ.isEmpty()) {x += (PQ.peek() * PQ.poll());}
        return x + y;
    }
}
