class Solution {
    int dp[];
    public int climbStairs(int n, int[] costs) {
        dp = new int[n];
        Arrays.fill(dp,-1);
        return solve(costs,0);
    }
    int solve(int arr[],int idx) {
        if(idx >= arr.length) {return 0;}
        if(dp[idx] != -1) {return dp[idx];} 
        int ans = Integer.MAX_VALUE;
        for(int jump = 1;jump <= 3;jump += 1) {
            int nextIndex = idx + jump;
            if(nextIndex <= arr.length) {
                int cost = arr[nextIndex - 1] + ((nextIndex - idx) * (nextIndex - idx));
                int next = cost + solve(arr,nextIndex);
                ans = Math.min(ans,next);
            }
        }
        return dp[idx] = ans;
    }
}
