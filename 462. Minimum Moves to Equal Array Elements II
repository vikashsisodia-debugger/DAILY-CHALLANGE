class Solution {
    public int minMoves2(int[] arr) {
        Arrays.sort(arr);
        int index = arr.length / 2;
        int num = arr[index];
        int ans = 0;
        for(int i = 0;i < arr.length;i++) {
            if(arr[i] == num) {continue;}
            int diff = Math.abs(arr[i] - num);
            ans += diff;
        }
        return ans;
    }
}
