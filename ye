class Solution {
    public boolean checkValidString(String s) {
        Stack<Character> stack = new Stack<>();
        int choices = 0;
        for(char ch : s.toCharArray()) {
            if(ch == '(') {
                stack.push(ch);
            }else if(ch == '*') {
                choices++;
            }else{
                if(!stack.isEmpty()) {
                    stack.pop();
                }else if(stack.isEmpty()) {
                    if(choices > 0) {
                        choices--;
                    }else{
                        return false;
                    }
                }
            }
        }
        choices = 0;
        stack = new Stack<>();
        for(int i = s.length() - 1;i >= 0;i--) {
            char ch = s.charAt(i);
            if(ch == ')') {
                stack.push(ch);
            }else if(ch == '*') {
                choices++;
            }else{
                if(!stack.isEmpty()) {
                    stack.pop();
                }else if(choices > 0) {
                    choices--;
                }else{
                    return false;
                }
            }
        }
        return true;
    }
}
