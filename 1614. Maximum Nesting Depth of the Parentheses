class Solution {
    public int maxDepth(String s) {
        int count = 0;
        int maxLen = 0;
        for(char ch : s.toCharArray()) {
            if(ch == '(') {
                count++;
                maxLen = Math.max(maxLen,count);
            }else if(ch == ')') {
                count--;
            }
        }
        return maxLen;
    }
}
